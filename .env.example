# Copy to .env before starting: cp .env.example .env
# The defaults below are for `docker compose up -d` (see README). For local development with
# Sail, also see the "Local development" block at the bottom.

# --- App ---------------------------------------------------------------------

# Technical name, used for cookie and cache prefixes. The name people see is set in Settings > Branding.
APP_NAME="Quest Board"
# production for a real install, local for development.
APP_ENV=production
# Required. Generate one with: echo "base64:$(openssl rand -base64 32)"
# Keep it safe and never change it later: changing it signs everyone out.
APP_KEY=
# Show detailed errors. Keep false on a real install.
APP_DEBUG=false
# The address people open in the browser. Use the https:// address if you have one.
APP_URL=http://localhost:8080
# Host port for the web app (docker compose only).
WEB_PORT=8080
# Address the host port listens on. 127.0.0.1 is for a reverse proxy on the same host.
# Use 0.0.0.0 only for a quick test without a proxy, or for a proxy on another machine
# with a firewall that only lets that proxy in.
WEB_BIND=127.0.0.1
# Time zone used to show dates (any PHP time zone, e.g. Asia/Yangon). Dates are stored in UTC.
APP_DISPLAY_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
BCRYPT_ROUNDS=12

# --- Public demo -------------------------------------------------------------
# Never enable this on a real install. The nightly reset wipes all data.
DEMO_MODE=false
# Daily reset time in UTC (HH:MM).
DEMO_RESET_TIME=00:00
# A demo install also needs shared maintenance mode across its containers:
# APP_MAINTENANCE_DRIVER=cache
# APP_MAINTENANCE_STORE=shared

# --- Database ----------------------------------------------------------------
# docker compose creates this MySQL user and database for you on first start.

DB_CONNECTION=mysql
# The compose service name. Use your own host if you run MySQL elsewhere.
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=quest_board
DB_USERNAME=quest
# Required. Choose a long random password before the first start.
DB_PASSWORD=

# --- Sessions, queue and cache (all stored in the database) ------------------

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Set to true when APP_URL starts with https:// so the login cookie is only sent over HTTPS.
# SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# --- Logging and mail --------------------------------------------------------

# stderr sends logs to `docker compose logs`.
LOG_CHANNEL=stderr
LOG_LEVEL=info
# The app sends no email, so mail is only logged.
MAIL_MAILER=log

# --- Local development with Sail ---------------------------------------------
# Only needed if you run the app with ./vendor/bin/sail. Uncomment and edit:
#   APP_ENV=local
#   APP_DEBUG=true
#   LOG_CHANNEL=stack
#   APP_PORT=8081            (the port Sail serves on)
#   APP_URL=http://localhost:8081
# Sail must use its own compose file, because docker-compose.yml is the production stack.
SAIL_FILES=compose.sail.yaml
